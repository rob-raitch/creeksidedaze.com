<script is:inline define:vars={{BASE_URL}}>
  // Fix all image paths to use BASE_URL
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.querySelector('.gallery-wrapper');
    if (gallery) {
      gallery.querySelectorAll('img').forEach(img => {
        if (img.src.startsWith('/') && !img.src.includes('http')) {
          img.src = BASE_URL + img.src.substring(1);
        }
      });
    }
  });
</script>

<style>
  .filter-controls { display: flex; justify-content: center; gap: 1rem; margin: 3rem 0; flex-wrap: wrap; }
  .filter-btn { 
    background: white; border: 1px solid rgba(0,0,0,0.1); padding: 0.6rem 1.5rem; 
    border-radius: 30px; cursor: pointer; transition: all 0.3s ease; font-family: 'Inter', sans-serif;
    color: #2d3e33;
  }
  .filter-btn.active { background: #2d3e33; color: white; border-color: #2d3e33; }

  .gallery-wrapper { column-count: 2; column-gap: 1.5rem; }
  @media (min-width: 1024px) { .gallery-wrapper { column-count: 3; } }

  .gallery-item {
    margin-bottom: 1.5rem;
    break-inside: avoid;
    transition: opacity 0.4s ease, transform 0.4s ease;
    display: block;
    opacity: 1;
  }

  .gallery-item img {
    width: 100%;
    border-radius: 8px;
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }
</style>

<script is:inline>
  // Filter Logic inside the component
  const filterBtns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          item.style.display = 'block';
          item.classList.add('is-visible');
          setTimeout(() => { item.style.opacity = '1'; }, 10);
        } else {
          item.style.opacity = '0';
          item.style.display = 'none';
          item.classList.remove('is-visible');
        }
      });

      // Refresh the Lightbox array from Layout_2.astro
      if (typeof initGallery === 'function') initGallery();
    });
  });
</script>